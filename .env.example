# ── Apps (Vercel + local) ─────────────────────────────────────────────
NEXT_PUBLIC_PB_URL=https://pocketbase.vmoliver.cloud
NEXT_PUBLIC_SITE_URL=https://cursos.andreamorotienda.com

# Colecciones (opcionales: estos son los valores por defecto)
NEXT_PUBLIC_PB_USERS=andreamoro_user
NEXT_PUBLIC_PB_COURSES=andreamoro_courses
NEXT_PUBLIC_PB_VIDEOS=andreamoro_videos
NEXT_PUBLIC_PB_MEDIA=andreamoro_media

# ── Solo .env local (scripts .bat). NUNCA en Vercel ───────────────────
# Colección vieja (origen de MIGRATE_V2, queda como backup)
NEXT_PUBLIC_PB_DATA=andreamoro_data

# CONVERT_VIDEOS / UPLOAD_BATCH: login con la cuenta admin
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# MIGRATE_V2 (ya ejecutado): superuser de PocketBase. Agregar solo si hay que
# volver a correr la migración, y borrar del .env al terminar.
# PB_SUPERUSER_EMAIL=
# PB_SUPERUSER_PASSWORD=
